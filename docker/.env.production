# =====================================================
# PigeonGram - Production конфигурация
# =====================================================

# 🚀 Сервер
SERVER_PORT=8080
SERVER_ENVIRONMENT=production
DOMAIN=test.pigeongram.com.ru
SSL_EMAIL=admin@test.pigeongram.com.ru

NGINX_PORT=80

# 🔐 Безопасность
SESSION_DURATION=24h
COOKIE_SECURE=false             # для HTTP (без HTTPS)
JWT_SECRET=g3z9H43oPfd8ZIMhXkBluuWqY3wwdKmJRfBYB8vtK02x8F3HcKT8zlhpyugolz

# 🐘 PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=pigeongram
DB_PASSWORD=pigeongram123
DB_NAME=pigeongram
DB_SSLMODE=disable

# 🔴 Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0
REDIS_TTL=5m
REDIS_PREFIX=pigeongram
REDIS_ENABLED=true

# 📁 MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=https://${DOMAIN}
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=pigeongram-files
MINIO_REGION=us-east-1
MINIO_UPLOAD_EXPIRY=15m
MINIO_DOWNLOAD_EXPIRY=24h
MINIO_MAX_FILE_SIZE=104857600

# 📧 Email (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 🔔 Telegram алерты (опционально)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# =====================================================
# GitHub для деплоя
# =====================================================

GITHUB_USER=PavlovVitaly
GITHUB_REPO=pigeongram
